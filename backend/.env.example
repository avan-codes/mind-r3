# NVIDIA API key (read by config.py from ~/Desktop/API_KEYs, or from this env var)
NVIDIA_API_KEY=nvapi-your-key-here

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# NVIDIA LLM
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
TEMPERATURE=0.0
MAX_TOKENS=65536
REASONING_BUDGET=16384
TOP_P=0.95

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5
MIN_SCORE=0.0

# CORS (FastAPI backend) — comma-separated allowed origins; "*" for all
CORS_ALLOW_ORIGINS=http://localhost:5174/,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
